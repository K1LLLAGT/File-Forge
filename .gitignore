backend/output/*
!backend/output/.gitkeep
backend/compressed/*
!backend/compressed/.gitkeep
backend/thumbs/*
!backend/thumbs/.gitkeep

# Env
.env
.env.local

# Editor/OS junk
*.bak
*.save
.DS_Store
tsconfig.tsbuildinfo
*.tsbuildinfo
