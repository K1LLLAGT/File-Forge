# Copy to .env.local (frontend) / export in your shell (backend+CLI) as needed.

# Used by backend/ff_queue.py — Redis connection for the job queue.
FILEFORGE_REDIS_URL=redis://127.0.0.1:6379/0

# Used by the Next.js API routes (app/api/**) to reach the FastAPI backend.
FILEFORGE_BACKEND_URL=http://127.0.0.1:8091

# Used by cli/fileforge-cli — base URL of the Next.js API layer (not the
# FastAPI backend directly).
FILEFORGE_API=http://127.0.0.1:8090
