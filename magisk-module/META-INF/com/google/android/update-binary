#!/sbin/sh
# Magisk module update-binary shim. Magisk provides the real installer; this
# forwards to it. Standard boilerplate required in every flashable module zip.
umask 022
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
install_module
exit 0
